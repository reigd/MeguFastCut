{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Megu FastCut",
  "version": "1.0.0",
  "identifier": "com.megufastcut.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Megu FastCut",
        "width": 1400,
        "height": 860,
        "minWidth": 1140,
        "minHeight": 740,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "?:/**/*",
          "[a-zA-Z]:/**/*",
          "C:/**/*",
          "D:/**/*",
          "E:/**/*",
          "F:/**/*",
          "G:/**/*",
          "H:/**/*"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "binaries/COPYING.GPLv3",
      "binaries/ffmpeg-build.txt"
    ]
  }
}
